{
  "scripts": {
    "build": "hugo --gc --minify && pagefind --site public",
    "index": "node -e \"require('fs').rmSync('static/pagefind',{recursive:true,force:true})\" && hugo --gc && pagefind --site public --output-path static/pagefind",
    "dev": "npm run index && hugo server"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1"
  }
}
